---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SelectedPatterns from '../../components/SelectedPatterns.astro';
import Breadcrumbs from '../../components/blocks/Breadcrumbs.astro';
import {getCollection} from 'astro:content';
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const base=import.meta.env.BASE_URL;
---
<SiteLayout title="文章" description="陽台觀察室的所有公開文章。">
  <div class="page-head"><Breadcrumbs items={[{label:'首頁',href:base},{label:'文章'}]} /></div>
  <section class="interior"><h1>文章</h1>{articles.length?<div class="links">{articles.map(x=><a href={base+'articles/'+x.id+'/'}><span>{x.data.title}</span><span class="meta">{x.data.publishedAt.toISOString().slice(0,10)}</span></a>)}</div>:<p>目前沒有公開文章。</p>}</section>
  <SelectedPatterns page="articles" />
</SiteLayout>
