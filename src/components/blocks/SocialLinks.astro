---
/**
 * Compact, dependency-free social identity links for all themes.
 * Brand SVGs: Simple Icons v16 via fixed-version jsDelivr. Their project is CC0;
 * individual marks may be subject to trademark/brand guidelines.
 * Generic icons are embedded as minimal SVGs. No tracking JS.
 */
type Platform = 'instagram'|'facebook'|'threads'|'youtube'|'line'|'github'|'linkedin'|'x'|'tiktok'|'pinterest'|'discord'|'telegram'|'spotify'|'email'|'phone'|'website'|'rss';
interface Item {platform:Platform;href:string;label?:string;}
interface Props {items?:Item[];previewPlatforms?:Platform[];showLabels?:boolean;title?:string;size?:'sm'|'md';}
const {items=[],previewPlatforms=[],showLabels=false,title='社群與聯絡連結',size='md'}=Astro.props;
const platforms:Record<Platform,{name:string;slug?:string}>={
 instagram:{name:'Instagram',slug:'instagram'}, facebook:{name:'Facebook',slug:'facebook'},
 threads:{name:'Threads',slug:'threads'}, youtube:{name:'YouTube',slug:'youtube'},
 line:{name:'LINE',slug:'line'}, github:{name:'GitHub',slug:'github'},
 linkedin:{name:'LinkedIn',slug:'linkedin'}, x:{name:'X',slug:'x'},
 tiktok:{name:'TikTok',slug:'tiktok'}, pinterest:{name:'Pinterest',slug:'pinterest'},
 discord:{name:'Discord',slug:'discord'}, telegram:{name:'Telegram',slug:'telegram'},
 spotify:{name:'Spotify',slug:'spotify'},
 email:{name:'Email'},phone:{name:'電話'},website:{name:'網站'},rss:{name:'RSS'}
};
const isPlatform=(p:string):p is Platform=>Object.prototype.hasOwnProperty.call(platforms,p);
const safeHref=(platform:Platform,href:string)=>{
 const v=href.trim();
 if(platform==='email'){const email=v.startsWith('mailto:')?v.slice(7):v;return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)?'mailto:'+email:undefined;}
 if(platform==='phone'){const tel=v.startsWith('tel:')?v.slice(4):v;const normalized=tel.replace(/[\s()-]/g,'');return /^\+?[0-9]{6,15}$/.test(normalized)?'tel:'+normalized:undefined;}
 try{const u=new URL(v);return u.protocol==='https:'?u.href:undefined}catch{return undefined;}
};
const links=items.filter(item=>isPlatform(item.platform)).map(item=>({...item,href:safeHref(item.platform,item.href)})).filter((item):item is Item=>Boolean(item.href));
const previews=previewPlatforms.filter(isPlatform);
const remoteIcon=(platform:Platform)=>platforms[platform].slug? 'https://cdn.jsdelivr.net/npm/simple-icons@v16/icons/'+platforms[platform].slug+'.svg':undefined;
---
<div class:list={['social-links', 'social-links--'+size, showLabels&&'social-links--labels']} aria-label={title}>
  {links.map(item=><a class="social-links__item" href={item.href} aria-label={item.label||platforms[item.platform].name} title={item.label||platforms[item.platform].name} rel={item.href.startsWith('https://')?'noopener noreferrer':undefined} target={item.href.startsWith('https://')?'_blank':undefined}>
    {remoteIcon(item.platform)?<span class="social-links__brand-icon" style={`--social-mask: url("${remoteIcon(item.platform)}")`} aria-hidden="true"></span>:
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {item.platform==='email'?<><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>:
      item.platform==='phone'?<path d="M6.6 3.6 9 6l-1.8 2.3a15 15 0 0 0 8.5 8.5L18 15l2.4 2.4a2 2 0 0 1-1.2 3.4C10.3 21.6 2.4 13.7 3.2 4.8a2 2 0 0 1 3.4-1.2Z"/>:
      item.platform==='rss'?<><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></>:
      <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18M12 3c-5 5-5 13 0 18"/></>}
      </svg>}
    {showLabels&&<span>{item.label||platforms[item.platform].name}</span>}
  </a>)}
  {previews.map(platform=><span class="social-links__item social-links__preview" title={platforms[platform].name+'（圖示預覽）'} aria-label={platforms[platform].name+' 圖示預覽'}>
    {remoteIcon(platform)?<span class="social-links__brand-icon" style={`--social-mask: url("${remoteIcon(platform)}")`} aria-hidden="true"></span>:
      <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      {platform==='email'?<><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></>:
      platform==='phone'?<path d="M6.6 3.6 9 6l-1.8 2.3a15 15 0 0 0 8.5 8.5L18 15l2.4 2.4a2 2 0 0 1-1.2 3.4C10.3 21.6 2.4 13.7 3.2 4.8a2 2 0 0 1 3.4-1.2Z"/>:
      <><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c5 5 5 13 0 18M12 3c-5 5-5 13 0 18"/></>}
      </svg>}
    {showLabels&&<span>{platforms[platform].name}</span>}
  </span>)}
</div>
