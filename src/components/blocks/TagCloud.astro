---
interface Props {tags:{name:string;count:number}[];baseHref:string;active?:string;}
const {tags,baseHref,active}=Astro.props;
---
<nav class="v2-tags" aria-label="按標籤瀏覽文章">{tags.map(tag=><a href={baseHref+'?tag='+encodeURIComponent(tag.name)} aria-current={active===tag.name?'true':undefined}>{tag.name}<span>{tag.count}</span></a>)}</nav>
